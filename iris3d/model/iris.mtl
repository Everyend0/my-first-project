# Iris mascot materials
# Kd holds the exact sRGB colours of the original drawing:
#   Iris_Yellow = #FEDB02 (254, 219, 2)   Iris_Black = #000000
# Blender's OBJ importer reads Kd as linear, so in Blender open
# model/iris.blend instead (or set Base Color hex to FEDB02 after import).
# Pr/Pm/Pc/Pcr: PBR extension (roughness, metallic, clearcoat, clearcoat roughness).

newmtl Iris_Yellow
Ka 0.000000 0.000000 0.000000
Kd 0.996078 0.858824 0.007843
Ks 0.087500 0.087500 0.087500
Ke 0.000000 0.000000 0.000000
Ns 310.500000
Ni 1.500000
d 1.000000
illum 2
Pr 0.450000
Pm 0.000000
Pc 0.350000
Pcr 0.080000

newmtl Iris_Black
Ka 0.000000 0.000000 0.000000
Kd 0.000000 0.000000 0.000000
Ks 0.083000 0.083000 0.083000
Ke 0.000000 0.000000 0.000000
Ns 198.000000
Ni 1.500000
d 1.000000
illum 2
Pr 0.300000
Pm 0.000000
Pc 0.300000
Pcr 0.100000

